256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"getLoan\",\"outputs\":[{\"components\":[{\"internalType\":\"address\",\"name\":\"borrower\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"lender\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"principalFlr\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"outstandingFlr\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"marginAmount\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"benchmarkBps\",\"type\":\"uint256\"},{\"internalType\":\"uint16\",\"name\":\"termEpochs\",\"type\":\"uint16\"},{\"internalType\":\"enum LoanVault.Status\",\"name\":\"status\",\"type\":\"uint8\"}],\"internalType\":\"struct LoanVault.Loan\",\"name\":\"\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"nextId\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"borrower\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"principalFlr\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"benchmarkBps\",\"type\":\"uint256\"},{\"internalType\":\"uint16\",\"name\":\"termEpochs\",\"type\":\"uint16\"}],\"name\":\"offer\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"title\":\"LoanVault \\u2014 Tributary v1 loan lifecycle (state machine core)\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"accept(uint256)\":{\"notice\":\"Borrower consents to the exact offered terms. Any term change         requires a fresh offer (M-02: authorization is invalidated when         its arguments change \\u2014 terms are immutable per id).\"},\"cancelOffer(uint256)\":{\"notice\":\"Lender withdraws an un-accepted offer (M-02: no standing \\\"yes\\\"         with an open expiry \\u2014 offers are revocable until consumed).\"},\"offer(address,uint256,uint256,uint16)\":{\"notice\":\"Lender posts loan terms addressed to one specific borrower.         Value-free: consent and funds never share a call.\"}},\"notice\":\"Loans are keyed by immutable id in a mapping; no invariant may         depend on array position (Debt DAO H-01/H-05). Every lifecycle         call asserts the id exists and the loan is in a legal state for         that action (H-04). Consent is recorded value-free; funds move         only in calls that execute the body (H-03). This commit is the state-machine skeleton per SPEC-V1 build order step 1: offer/accept/cancel + the status graph + guards, with funds flows landing in the next build steps (MarginEscrow, RewardCollector integration).\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/LoanVault.sol\":\"LoanVault\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":false,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"src/LoanVault.sol\":{\"keccak256\":\"0xf1a9e390084221390f069d86c7c27051365144b2d84e01104cf5f7b6cfd4f731\",\"license\":\"BUSL-1.1\",\"urls\":[\"bzz-raw://b7c7cc0d0c7b42802cdb08e794812a8937b2368dbd526159d95bbe6aa29fd0a0\",\"dweb:/ipfs/QmSJmTANQRWW5USawEbMm6QqUcoMZee85RB4PMgmmcz6g1\"]},\"src/TermsLib.sol\":{\"keccak256\":\"0x7d30bd6d90e866e47c1c3c92208066bb1b0a132c2249e64e2093ad78e41658b1\",\"license\":\"BUSL-1.1\",\"urls\":[\"bzz-raw://7cbd45a96ea5ee0078e18e4378cbcc635bc29a4202493cedb9ad0f3cedc7baa5\",\"dweb:/ipfs/QmS4cSkdMXBTRcbZeSSRkGXnMSb4vpB317WuGvnHnfL5ht\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.30+commit.73712a01"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"uint256","name":"id","type":"uint256"}],"type":"error","name":"LoanDoesNotExist"},{"inputs":[{"internalType":"uint256","name":"id","type":"uint256"},{"internalType"